# Host build
build/
*.o
*.d

# ESP-IDF
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# STM32
Debug/
Release/
.settings/

# .project and .cproject are NOT ignored, deliberately. In an ordinary Eclipse
# project they are per-machine noise. Here they carry the only copy of how the
# shared tree is wired into the Cube project: three linked folders pointing at
# firmware/core, firmware/platform/stm32 and firmware/app/stm32/src, plus the
# include paths that reach them. None of that can be regenerated from the .ioc
# — CubeMX does not know those directories exist. Ignore them and a fresh
# clone builds a firmware with no core in it.

# Python
__pycache__/
*.pyc
.venv/
venv/

# Captured sessions — data is regenerated, not versioned.
# Reference baselines live in data/baselines/ and ARE versioned.
data/sessions/

# Graphs are regenerated from the CSVs next to them. The text report IS
# versioned: it diffs, so a change in the rules shows up in review.
*_plots/

# Editor caches
.cache/

# macOS
.DS_Store

# Scratch files from unrelated practice — kept on disk, out of the repo
tempCodeRunnerFile.js
t.js
