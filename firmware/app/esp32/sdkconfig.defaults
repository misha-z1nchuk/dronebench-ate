# Committed build configuration. The generated sdkconfig is gitignored — this
# file is what makes a fresh clone build the same firmware.

# Keep the target build as strict as the host build: string literals are const,
# and code that forgets it is a bug waiting for a flash write to random memory.
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# Confirmed with `esptool flash_id` on the actual board: 4 MB.
# Not assumed — configuring 4 MB on a 2 MB part produces a board that flashes
# and then fails at runtime.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Telemetry at 500 Hz needs more than 115200 can carry — see plan section 7.
#
# 460800, not 921600: the bridge on this board is a CH340 (VID 1a86, PID 7523),
# and 921600 came out as garbage through the macOS driver. 460800 still leaves
# 2094 lines/s against the 500 needed.
#
# The baud rate has a Kconfig prompt only when the console is set to CUSTOM;
# without this line the next one is silently ignored and the build keeps the
# 115200 default with no warning. CUSTOM leaves TX/RX on GPIO 1/3 for the
# ESP32, which is where they already were.
#
# ESPTOOLPY_MONITOR_BAUD is deliberately not set: it has no prompt and
# defaults to ESP_CONSOLE_UART_BAUDRATE, so `idf.py monitor` follows on its
# own. One place to change, and no way for the two to disagree.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=460800

# The measurement loop runs at 500 Hz, i.e. a 2 ms period. At the default tick
# rate of 100 Hz the scheduler's resolution is 10 ms, and pdMS_TO_TICKS(2)
# truncates to zero ticks — which xTaskDelayUntil rejects outright.
#
# 1000 Hz is the maximum this port allows and makes one tick 1 ms, so a period
# is exactly two ticks. The extra 900 tick interrupts per second cost nothing
# measurable against 240 MHz.
#
# Note this only fixes the *scheduling*. Sample timestamps come from
# esp_timer_get_time() at microsecond resolution, so the integration stays
# accurate even when a wake-up lands late — which is precisely why the sampler
# records real timestamps instead of assuming the nominal period.
CONFIG_FREERTOS_HZ=1000
